{
  "name": "ai-vision-studio",
  "version": "2.0.0-rc.1",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "node --experimental-strip-types --test tests/*.test.cjs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@mediapipe/pose": "^0.5.1675469404",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.aivision.studio",
    "productName": "AI Vision Studio",
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
